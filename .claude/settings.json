{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(make)", "Bash(make *)",
      "Bash(uv sync *)", "Bash(uv add *)", "Bash(uv run pytest *)", "Bash(uv run ruff *)", "Bash(uv run python *)",
      "Bash(python3 *)", "Bash(qemu-system-i386 *)",
      "Bash(tools/check-toolchain.sh *)", "Bash(tools/check-paths.sh *)",
      "Bash(arduino-cli compile *)",
      "Bash(git add *)", "Bash(git commit *)", "Bash(git status)", "Bash(git status *)",
      "Bash(git diff)", "Bash(git diff *)", "Bash(git log)", "Bash(git log *)", "Bash(git show *)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(**/.env)", "Read(**/.env.*)",
      "Bash(git push)", "Bash(git push *)", "Bash(git add .env*)",
      "Bash(arduino-cli upload)", "Bash(arduino-cli upload *)", "Bash(avrdude *)",
      "Bash(sudo *)", "Bash(curl *)", "Bash(wget *)",
      "Bash(uv run ring3 run)", "Bash(uv run ring3 run *)"
    ]
  }
}
